# AI Services Configuration
NEXT_PUBLIC_AI_PROVIDER=mock # Options: 'openai', 'gemini', 'mock'
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Database & Auth (Optional - Fallback to LocalStorage Mock System)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="HARI BUSINESS BOT"

# Secret Activation Codes (Server-side ONLY - Stored securely on server, verified via API)
STARTER_ACTIVATION_CODE=your_starter_code_here
GROWTH_ACTIVATION_CODE=your_growth_code_here
PRO_BUSINESS_ACTIVATION_CODE=your_pro_business_code_here
